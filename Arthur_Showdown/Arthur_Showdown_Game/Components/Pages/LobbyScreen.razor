@page "/lobby"

<Scene ImagemUrl="@_ImgService.ObterBackgroundLobby()">

    <GameLayer>
        <div class="gameplay-container" tabindex="0" @ref="GameplayContainer" autofocus>
            <Arena IsLobby=@true
                   QuantidadeTiles="5"
                   TileTremendoId="TileTremendoId"
                   />
        </div>
    </GameLayer>

    <UILayer>
        <div class="hud-top-left" style="transform: scale(@_Controle.EscalaHudCss);">
            <button type="button" class="hud-nav-btn" @onclick="VoltarMenuInicial">⬅ Menu Inicial</button>
        </div>

        <MapButton OnStartClicked="AbrirMapa" />

        <div class="hud-bottom" style="transform: translateX(-50%) scale(@_Controle.EscalaHudCss); transform-origin: bottom center;">
            @if (_PlayerService.CurrentCharacter != null)
            {
                <AtaquesContainer/>
            }
        </div>

        <TouchControls />

        @if (JanelaAberta == ModalAberto.Mapa)
        {
            <MapModal OnClose="FecharModal" />
        }
        else if (JanelaAberta == ModalAberto.Loja)
        {
            <ShopModal OnClose="FecharModal" />
        }
        else if (JanelaAberta == ModalAberto.Scoreboard)
        {
            <ScoreboardModal OnClose="FecharModal" />
        }
    </UILayer>

</Scene>
