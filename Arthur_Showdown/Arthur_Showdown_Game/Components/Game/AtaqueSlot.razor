@inherits ComponentBase
<div class="ataque-slot @(Ataque.IsFastAction ? "fast-action" : "") @(Mini ? "mini" : "") @(CooldownRestante > 0 ? "em-cooldown" : "")">
    <div class="slot-numero">@Numero</div>
    <div class="slot-imagem">
        @if (!string.IsNullOrEmpty(Ataque.ImagemUrl))
        {
            <img src="@Ataque.ImagemUrl" alt="@Ataque.Nome" />
        }
        else
        {
            <span class="slot-icone-fallback">⚔</span>
        }
    </div>
    @if (!Mini)
    {
        <div class="slot-cooldowns">
            @for (int i = 0; i < Ataque.Cooldown; i++)
            {
                int prontos = Math.Max(0, Ataque.Cooldown - CooldownRestante);
                <div class="cooldown-block @(i < prontos ? "pronto" : "gasto")"></div>
            }
        </div>
        <div class="ataque-tooltip">
            <strong>@Ataque.Nome</strong>
            <p>@Ataque.Descricao</p>
        </div>
    }
</div>
