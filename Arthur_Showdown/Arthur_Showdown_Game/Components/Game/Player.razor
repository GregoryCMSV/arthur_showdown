@using Arthur_Showdown_Game.Models
@if (CurrentCharacter() != null)
{
    var ch = CurrentCharacter()!;
    <div class="personagem-base" style="transform: translateX(calc(@ch.PosicaoPersonagem * 11.2vw));">
        @if (FilaJogador.Any())
        {
            <div class="fila-vertical">
                @foreach (var c in FilaJogador)
                {
                    <div @key="c" class="fila-item">
                        <div class="fila-controles">
                            <button type="button" class="fila-btn" title="Subir visualmente" @onclick="() => MoverFila(c, 1)" @onclick:stopPropagation="true">▲</button>
                            <button type="button" class="fila-btn" title="Descer visualmente" @onclick="() => MoverFila(c, -1)" @onclick:stopPropagation="true">▼</button>
                        </div>
                        <div @onclick="() => RemoverDaFila(c)" title="Clique para remover da fila" style="cursor: pointer;">
                            <AtaqueSlot Ataque="c.Ataque" Numero="c.Ataque.Dano" Mini="true" />
                        </div>
                    </div>
                }
            </div>
        }
        <div class="personagem-animacao @ClasseAnimacao">
            <div class="personagem-visual @ClasseGiro" style="transform: scaleX(@ch.DirecaoOlhar);">
                @if (ch.Personagem != null && !string.IsNullOrEmpty(ch.Personagem.ImagemUrl))
                {
                    <img src="@ch.Personagem.ImagemUrl" alt="@ch.Personagem.Nome" style="width: 100%; height: 100%; object-fit: contain;" />
                }
            </div>
        </div>
        @if (_Turnos.Ctx?.EscudoAtivo == true)
        {
            <div class="efeito-escudo-elipse"></div>
        }
    </div>
}
