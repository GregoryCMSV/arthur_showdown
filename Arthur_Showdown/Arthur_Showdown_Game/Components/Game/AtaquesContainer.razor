<div class="ataques-root">
    <div class="ataques-container" style="height:@(SlotH)px; width:@(Math.Max(1, _cartas.Count) * (SlotW + Gap))px">
        @foreach (var c in _cartas.Where(c => !c.EmFila))
        {
            var (x, y) = Posicao(c);
            <div @key="c" class="carta-wrapper @(c.EmCooldown ? "bloqueada" : "")"
                 style="transform:translate(@(x)px,@(y)px)"
                 @onclick="() => Enfileirar(c)">
                <AtaqueSlot Ataque="c.Ataque" Numero="c.Ataque.Dano" CooldownRestante="c.CooldownRestante" />
            </div>
        }
    </div>
</div>
