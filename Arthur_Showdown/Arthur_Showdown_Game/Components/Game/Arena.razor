<div class="battle-arena">
    @for (int i = 0; i < QuantidadeTiles; i++)
    {
        <Tile Indice="i"
              IsEspecial="IsLobby && (i == 0 || i == 1 || i == 4)"
              IsPerigo="!IsLobby && Inimigos.Any(ini => ini.Vivo && ini.Telegrafando && ini.Estado.Posicao == i)"
              IsTremendo="i == TileTremendoId" />
    }

    <Player StartPosition="PlayerStartPosition" />

    @foreach (var ini in Inimigos.Where(i => i.Vivo))
    {
        var seta = SetaMovimento(ini);
        <div @key="ini" class="inimigo-base" style="transform: translateX(calc(@ini.Estado.Posicao * 11.2vw));">
            @if (MostrarOrdemInimigos)
            {
                <div class="inimigo-ordem-badge" title="Ordem de ação neste turno">@OrdemAcao(ini)º</div>
            }
            @if (ini.Preparado)
            {
                <div class="inimigo-fila">
                    @foreach (var atk in ini.AtaquesNaFila)
                    {
                        <AtaqueSlot Ataque="atk" Numero="atk.Dano" Mini="true" />
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(seta))
            {
                <div class="inimigo-intencao">@seta</div>
            }
            @if (ini.EfeitoEspelhoAtivo)
            {
                <div class="efeito-espelho-quadrado"></div>
            }
            <div class="inimigo-visual @(ini.Amaldicoado ? "amaldicoado" : "")" style="transform: scaleX(@Rumo(ini));">
                @if (!string.IsNullOrEmpty(ini.Estado.ImagemUrl))
                {
                    <img src="@ini.Estado.ImagemUrl" alt="@ini.Estado.Nome" />
                }
            </div>
            <div class="inimigo-vida">❤ @ini.Estado.VidaAtual</div>
        </div>
    }

    @if (!IsLobby && _Turnos.Ctx?.EfeitoVisual != null)
    {
        var ef = _Turnos.Ctx.EfeitoVisual;
        @foreach (var tile in ef.TilesImpacto)
        {
            <div class="efeito-impacto-tile" style="transform: translateX(calc(@tile * 11.2vw));">
                <div class="forma-impacto-losango"></div>
                <div class="forma-impacto-corte"></div>
            </div>
        }

        @if (ef.EhFlecha)
        {
            <div class="efeito-flecha-proj"
                 style="--orig: calc(@ef.OrigemTile * 11.2vw + 4vw); --dest: calc(@ef.DestinoTile * 11.2vw + 4vw);">
                <div class="flecha-corpo" style="transform: scaleX(@(ef.Direcao >= 0 ? 1 : -1));">
                    <div class="flecha-haste"></div>
                    <div class="flecha-ponta"></div>
                </div>
            </div>
        }
    }
</div>
